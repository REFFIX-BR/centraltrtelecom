# URL do painel/API de propagandas (sem barra no final).
# Em desenvolvimento com PM2 na mesma máquina:
# EXPO_PUBLIC_BANNERS_URL=http://localhost:4050
#
# No celular físico, use o IP da máquina/servidor:
# EXPO_PUBLIC_BANNERS_URL=http://192.168.0.10:4050
#
# Em produção, use o domínio público do PM2:
# EXPO_PUBLIC_BANNERS_URL=https://propagandas.trtelecom.net
EXPO_PUBLIC_BANNERS_URL=http://localhost:4050

# Comercial — solicitação de upgrade (POST /api/vendachat)
# EXPO_PUBLIC_COMERCIAL_URL=https://comercial.trtelecom.net
# Código do vendedor obrigatório no comercial (cadastro ativo):
# EXPO_PUBLIC_COMERCIAL_VENDEDOR=TRDL2OLA

# WhatsApp do comercial (só dígitos, com ou sem 55) — recebe o pedido de upgrade
EXPO_PUBLIC_UPGRADE_WHATSAPP=24993279575
