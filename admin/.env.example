ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=4050
ADMIN_API_TOKEN=trtelecom-admin-2026
ADMIN_PUBLIC_URL=https://centralapi.trtelecom.net

# Postgres — use DATABASE_URL OU os campos DB_*
# Dentro do Docker: DB_HOST=postgres
# Fora do Docker (sua máquina): DB_HOST=localhost
DATABASE_URL=postgresql://centralapp:SENHA@postgres:5432/centralapp
DB_HOST=postgres
DB_PORT=5432
DB_NAME=centralapp
DB_USER=centralapp
DB_PASSWORD=SENHA

# MinIO / S3 — imagens do super-admin e do app
MINIO_ENDPOINT=s3.trtelecom.net
MINIO_ACCESS_KEY=sua_access_key
MINIO_SECRET_KEY=sua_secret_key
MINIO_BUCKET=centralapp
# Opcional (default = https://MINIO_ENDPOINT)
# MINIO_PUBLIC_URL=https://s3.trtelecom.net
# MINIO_REGION=us-east-1
# MINIO_KEY_PREFIX=banners

# MVNO Corevo / EAI — NUNCA coloque isso no app Expo (.env da raiz)
# Homologação: https://api.corevo.dev/
# Produção:    https://api.corevo.com.br/
MVNO_BASE_URL=https://api.corevo.com.br
MVNO_TENANT=seu_tenant
MVNO_CLIENT_ID=seu_client_id
MVNO_CLIENT_SECRET=seu_client_secret
