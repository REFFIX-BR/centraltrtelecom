{
  "expo": {
    "name": "TR Telecom",
    "slug": "trtelecom-central-do-assinante",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trtelecom",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trtelecom.central",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "A TR Telecom envia avisos sobre faturas, suporte e novidades da sua conta."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E2C5B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "central.tr.telecom"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E2C5B"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E2C5B",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6564e120-c3bc-4b5a-ad08-5f2d235c21fa"
      }
    },
    "owner": "trtelecoms-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6564e120-c3bc-4b5a-ad08-5f2d235c21fa"
    }
  }
}
